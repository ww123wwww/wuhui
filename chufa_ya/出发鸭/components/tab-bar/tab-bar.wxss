.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #ffffff;
  border-top: 1rpx solid transparent;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar-inner {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 16rpx 8rpx;
  height: 100rpx;
  position: relative;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  transition: all 0.2s;
}

.tab-item.active {
  color: #705d00;
  font-weight: 700;
}

.tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.tab-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.tab-label {
  font-size: 20rpx;
  color: #5f5e5e;
}

.tab-item.active .tab-label {
  color: #705d00;
  font-weight: 700;
}

/* FAB 发布按钮 */
.fab-item {
  position: relative;
  margin-top: -60rpx;
}

.fab-btn {
  width: 112rpx;
  height: 112rpx;
  background: #ffd700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(112, 93, 0, 0.2);
}

.fab-icon {
  font-size: 56rpx;
  color: #705e00;
  font-weight: 400;
  line-height: 1;
}

.fab-label {
  font-size: 20rpx;
  color: #1a1c1d;
  font-weight: 700;
  margin-top: 4rpx;
}
