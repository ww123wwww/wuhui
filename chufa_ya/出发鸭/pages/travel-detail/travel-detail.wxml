<!-- 游记/攻略详情页 -->
<view class="page">
  <!-- 透明导航 -->
  <view class="top-nav" style="padding-top: {{statusBarHeight + 12}}px;">
    <view class="top-nav-left" bindtap="goBack">
      <view class="nav-btn"><text>←</text></view>
    </view>
    <view class="top-nav-right">
      <view class="nav-btn"><text>📤</text></view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <text>加载中...</text>
  </view>

  <!-- 内容 -->
  <scroll-view wx:elif="{{detail}}" scroll-y class="content" enhanced show-scrollbar="{{false}}">
    <view class="content-card">
      <view class="pull-handle"></view>

      <!-- 头部大图 -->
      <view class="hero">
        <image wx:if="{{detail.coverUrl || imageList.length > 0}}" class="hero-img" src="{{detail.coverUrl || imageList[0]}}" mode="aspectFill"></image>
        <view wx:else class="hero-img hero-img-placeholder">
          <text class="hero-img-text">📷</text>
        </view>
        <view class="hero-overlay"></view>
        <view class="hero-text">
            <text class="hero-date">{{publishTime}}</text>
            <text class="hero-title">{{detail.title}}</text>
          </view>
      </view>

      <!-- 作者卡片 -->
      <view class="author-card">
        <view class="author-info">
          <image class="author-avatar" src="{{detail.avatarUrl || '/static/Placeholder Icon/默认头像.png'}}" mode="aspectFill" bindtap="showAuthorModal"></image>
          <view class="author-detail">
            <text class="author-name">{{detail.nickname || '匿名用户'}}</text>
            <view class="author-desc"><image class="author-desc-icon" src="/static/app_tabbar/定位.png" mode="aspectFit"></image><text class="author-desc-text">{{detail.location || detail.ipLocation || ''}}</text></view>
          </view>
        </view>
        <view wx:if="{{!isCurrentUser}}" class="follow-btn {{isFollowing ? 'following' : ''}}" bindtap="onFollow">
          <text>{{isFollowing ? '已关注' : '关注'}}</text>
        </view>
      </view>

      <!-- 攻略概览/游记故事 -->
      <view class="section">
        <view class="section-header">
          <text class="section-icon">📖</text>
          <text class="section-title">{{detail.contentType === 'note' ? '游记故事' : '攻略概览'}}</text>
        </view>
        <view class="story-text">
          <text>{{detail.content || '暂无内容'}}</text>
        </view>
      </view>

      <!-- 精彩瞬间 -->
      <view class="section" wx:if="{{imageList.length > 0}}">
        <view class="section-header">
          <text class="section-icon">📷</text>
          <text class="section-title">精彩瞬间</text>
        </view>
        <view class="moments-grid">
          <block wx:for="{{imageList}}" wx:key="index">
            <view class="moment-card {{index === 0 ? 'moment-large' : ''}}">
              <image class="moment-img" src="{{item}}" mode="aspectFill"></image>
            </view>
          </block>
        </view>
      </view>

      <view style="height: 200rpx;"></view>
    </view>
  </scroll-view>

  <!-- 空状态 -->
  <view wx:else class="empty-container">
    <text>暂无内容</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar" wx:if="{{detail}}">
    <!-- 游记详情页：收藏和点赞按钮 -->
    <view wx:if="{{contentType !== 'travelogue'}}" class="bottom-bar-note">
      <view class="bottom-action" bindtap="onCollect">
        <image class="bottom-action-icon" src="{{isCollected ? '/static/app_tabbar/已收藏.png' : '/static/app_tabbar/收藏.png'}}" mode="aspectFit"></image>
        <text class="bottom-action-label">{{collectCount}}</text>
      </view>
      <view class="bottom-action" bindtap="onLike">
        <image class="bottom-action-icon" src="{{isLiked ? '/static/app_tabbar/已点赞.png' : '/static/app_tabbar/点赞.png'}}" mode="aspectFit"></image>
        <text class="bottom-action-label">{{likeCount}}</text>
      </view>
    </view>
    
    <!-- 攻略详情页：收藏、点赞和保存行程按钮 -->
    <view wx:if="{{contentType === 'travelogue'}}" class="bottom-bar-guide">
      <view class="bottom-actions-left">
        <view class="bottom-action" bindtap="onCollect">
          <image class="bottom-action-icon" src="{{isCollected ? '/static/app_tabbar/已收藏.png' : '/static/app_tabbar/收藏.png'}}" mode="aspectFit"></image>
          <text class="bottom-action-label">{{collectCount}}</text>
        </view>
        <view class="bottom-action" bindtap="onLike">
          <image class="bottom-action-icon" src="{{isLiked ? '/static/app_tabbar/已点赞.png' : '/static/app_tabbar/点赞.png'}}" mode="aspectFit"></image>
          <text class="bottom-action-label">{{likeCount}}</text>
        </view>
      </view>
      <view class="save-trip-btn {{isSavedToTrip ? 'saved' : ''}}" bindtap="saveToTrip">
        <text>{{isSavedToTrip ? '已保存' : '保存到行程'}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 作者信息弹窗 -->
<view wx:if="{{showAuthorModal}}" class="modal-overlay" bindtap="hideAuthorModal">
  <view class="author-modal" catchtap="preventBubble">
    <view class="modal-close" bindtap="hideAuthorModal">✕</view>
    <view class="author-modal-content">
      <image class="modal-avatar" src="{{detail.avatarUrl || '/static/Placeholder Icon/默认头像.png'}}" mode="aspectFill"></image>
      <text class="modal-nickname">{{detail.nickname || '匿名用户'}}</text>
      <text class="modal-tag">{{detail.tag || '旅行爱好者'}}</text>
      <view class="modal-stats">
        <view class="modal-stat">
          <text class="stat-num">{{detail.followCount || 0}}</text>
          <text class="stat-label">关注</text>
        </view>
        <view class="modal-stat">
          <text class="stat-num">{{detail.fansCount || 0}}</text>
          <text class="stat-label">粉丝</text>
        </view>
      </view>
      <view class="modal-actions">
        <view wx:if="{{!isCurrentUser}}" class="modal-btn follow-btn" bindtap="handleFollow">
          <text>{{isFollowing ? '已关注' : '关注'}}</text>
        </view>
        <view class="modal-btn message-btn" bindtap="goToChat">
          <text>发私信</text>
        </view>
      </view>
    </view>
  </view>
</view>