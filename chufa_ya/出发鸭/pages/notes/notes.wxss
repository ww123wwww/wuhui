.page {
  min-height: 100vh;
  background: #f9f9fb;
}

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #f9f9fb;
  padding: 12rpx 32rpx 16rpx;
  display: flex;
  align-items: center;
}

.header-back {
  font-size: 40rpx;
  color: #705d00;
}

.page-content {
  padding: 0 32rpx;
}

/* 搜索 */
.search-section {
  margin-bottom: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #f3f3f5;
  border-radius: 9999rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  border: 2rpx solid transparent;
}

.search-bar:focus-within {
  border-color: #ffd700;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  background: transparent;
}

.search-btn {
  background: #ffd700;
  color: #705e00;
  font-size: 24rpx;
  padding: 16rpx 32rpx;
  border-radius: 9999rpx;
  margin-left: 16rpx;
}

/* 地点筛选 */
.location-filter {
  margin-bottom: 32rpx;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: flex;
  gap: 24rpx;
}

.filter-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.filter-item:active {
  transform: scale(0.95);
}

.filter-city-icon {
  width: 80rpx;
  height: 80rpx;
}

.filter-city-icon-text {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.filter-img {
  width: 100%;
  height: 100%;
}

.filter-label {
  font-size: 24rpx;
  color: #5f5e5e;
}

.filter-item.active .filter-label {
  color: #1a1c1d;
  font-weight: 700;
}

/* 区块标题 */
.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1c1d;
}

/* 瀑布流 */
.waterfall {
  display: flex;
  gap: 24rpx;
}

.waterfall-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.waterfall-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.waterfall-img-wrap {
  position: relative;
  width: 100%;
}

.waterfall-img {
  width: 100%;
  display: block;
}

.waterfall-img-placeholder {
  background: #f3f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.waterfall-img-text {
  font-size: 64rpx;
}

.waterfall-rating {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(0,0,0,0.3);
  backdrop-filter: blur(12rpx);
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
}

.waterfall-star {
  font-size: 22rpx;
}

.waterfall-score {
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

.waterfall-body {
  padding: 20rpx;
}

.waterfall-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1c1d;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 16rpx;
}

.waterfall-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.waterfall-user {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.waterfall-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.waterfall-avatar-placeholder {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffd700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #705e00;
  flex-shrink: 0;
}

.waterfall-username {
  font-size: 22rpx;
  color: #5f5e5e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waterfall-likes {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.waterfall-like-icon {
  width: 34rpx;
  height: 34rpx;
}

.waterfall-like-count {
  font-size: 22rpx;
  color: #5f5e5e;
}
