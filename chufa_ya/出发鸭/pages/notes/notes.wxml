<!-- 看游记页 - _12 -->
<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight + 12}}px;">
    <view class="header-left" bindtap="goBack">
      <text class="header-back">←</text>
    </view>
  </view>

  <scroll-view scroll-y class="page-content" enhanced show-scrollbar="{{false}}">
    <!-- 搜索 -->
    <view class="search-section">
      <view class="search-bar">
        <image class="search-icon" src="/static/app_tabbar/搜索.png" mode="aspectFit"></image>
        <input class="search-input" placeholder="搜索你想去的游记..." placeholder-style="color:#c8c6c5;" />
        <view class="search-btn">
          <text>搜索</text>
        </view>
      </view>
    </view>

    <!-- 地点筛选 -->
    <view class="location-filter">
      <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
        <view class="filter-list">
          <view wx:for="{{locations}}" wx:key="id" class="filter-item {{currentFilter === item.id ? 'active' : ''}}" data-filter="{{item.id}}" bindtap="selectFilter">
            <image wx:if="{{item.icon}}" class="filter-city-icon" src="{{item.icon}}" mode="aspectFit"></image>
            <text wx:else class="filter-city-icon-text">📍</text>
            <text class="filter-label">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 为你推荐 -->
    <view class="section-header">
      <text class="section-title">为你推荐</text>
    </view>

    <view class="waterfall">
      <view class="waterfall-col">
        <block wx:for="{{leftPosts}}" wx:key="id">
          <view class="waterfall-card" bindtap="viewDetail" data-id="{{item.id}}">
            <view class="waterfall-img-wrap">
              <image wx:if="{{item.image}}" class="waterfall-img" src="{{item.image}}" mode="widthFix" style="height: {{item.imgHeight}}rpx;"></image>
              <view wx:else class="waterfall-img-placeholder" style="height: {{item.imgHeight}}rpx;">
                <text class="waterfall-img-text">📷</text>
              </view>
              <view class="waterfall-rating" wx:if="{{item.rating}}">
                <text class="waterfall-star">⭐</text>
                <text class="waterfall-score">{{item.rating}}</text>
              </view>
            </view>
            <view class="waterfall-body">
              <text class="waterfall-title">{{item.title}}</text>
              <view class="waterfall-footer">
                <view class="waterfall-user">
                  <image class="waterfall-avatar" src="{{item.avatar || '/static/Placeholder Icon/默认头像.png'}}" mode="aspectFill"></image>
                  <text class="waterfall-username">{{item.username}}</text>
                </view>
                <view class="waterfall-likes">
                  <image class="waterfall-like-icon" src="{{item.isLiked ? '/static/app_tabbar/已点赞.png' : '/static/app_tabbar/点赞.png'}}" mode="aspectFit"></image>
                  <text class="waterfall-like-count">{{item.likes}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
      <view class="waterfall-col">
        <block wx:for="{{rightPosts}}" wx:key="id">
          <view class="waterfall-card" bindtap="viewDetail" data-id="{{item.id}}">
            <view class="waterfall-img-wrap">
              <image wx:if="{{item.image}}" class="waterfall-img" src="{{item.image}}" mode="widthFix" style="height: {{item.imgHeight}}rpx;"></image>
              <view wx:else class="waterfall-img-placeholder" style="height: {{item.imgHeight}}rpx;">
                <text class="waterfall-img-text">📷</text>
              </view>
              <view class="waterfall-rating" wx:if="{{item.rating}}">
                <text class="waterfall-star">⭐</text>
                <text class="waterfall-score">{{item.rating}}</text>
              </view>
            </view>
            <view class="waterfall-body">
              <text class="waterfall-title">{{item.title}}</text>
              <view class="waterfall-footer">
                <view class="waterfall-user">
                  <image class="waterfall-avatar" src="{{item.avatar || '/static/Placeholder Icon/默认头像.png'}}" mode="aspectFill"></image>
                  <text class="waterfall-username">{{item.username}}</text>
                </view>
                <view class="waterfall-likes">
                  <image class="waterfall-like-icon" src="{{item.isLiked ? '/static/app_tabbar/已点赞.png' : '/static/app_tabbar/点赞.png'}}" mode="aspectFit"></image>
                  <text class="waterfall-like-count">{{item.likes}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view style="height: 80rpx;"></view>
  </scroll-view>
</view>
