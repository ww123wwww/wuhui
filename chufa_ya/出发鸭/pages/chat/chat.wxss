.chat-page {
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 聊天内容区域 */
.chat-content {
  height: calc(100vh - 120rpx);
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.message-item {
  margin-bottom: 24rpx;
}

/* 自己的消息 - 显示在右侧 */
.self-wrapper {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: flex-end;
}

.self-wrapper .bubble-container {
  display: flex;
  align-items: flex-end;
  margin-right: 4rpx;
}

.self-wrapper .avatar-wrapper {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

/* 对方的消息 - 显示在左侧 */
.other-wrapper {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: flex-end;
}

.other-wrapper .avatar-wrapper {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.other-wrapper .bubble-container {
  display: flex;
  align-items: flex-end;
  margin-left: 4rpx;
}

/* 头像样式 */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eee;
}

.avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 气泡样式 */
.message-bubble {
  max-width: 600rpx;
  min-width: 80rpx;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  word-break: break-word;
  white-space: pre-wrap;
  display: inline-block;
  box-sizing: border-box;
  overflow-wrap: break-word;
}

.self-bubble {
  background: #7a5d00;
  border-bottom-right-radius: 8rpx;
}

.self-bubble text {
  color: #fff;
  font-size: 28rpx;
  line-height: 1.6;
}

.other-bubble {
  background: #fff;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.other-bubble text {
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 箭头样式 */
.arrow {
  width: 0;
  height: 0;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.self-arrow {
  border-left: 14rpx solid #7a5d00;
  margin-left: -6rpx;
  margin-right: 6rpx;
}

.other-arrow {
  border-right: 14rpx solid #fff;
  margin-right: -6rpx;
  margin-left: 6rpx;
}

/* 输入区域 */
.chat-input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.input-wrapper {
  flex: 1;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  min-height: 72rpx;
  max-height: 200rpx;
}

.input-box {
  width: 100%;
  min-height: 40rpx;
  max-height: 168rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background: transparent;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  background: #7a5d00;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-btn text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}