.page {
  min-height: 100vh;
  background: #f9f9fb;
}

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #f9f9fb;
  padding: 12rpx 32rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-back {
  font-size: 40rpx;
  color: #1a1c1d;
}

.header-search {
  flex: 1;
  display: flex;
  align-items: center;
  background: #e8e8ea;
  border-radius: 9999rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  background: transparent;
}

.search-btn {
  background: #ffd700;
  color: #705e00;
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 32rpx;
  border-radius: 9999rpx;
}

.page-content {
  padding: 0 32rpx;
}

/* 搭子卡片 */
.buddy-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.buddy-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border: 2rpx solid rgba(208, 198, 171, 0.2);
}

.buddy-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.buddy-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.buddy-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #ffd700;
}

.buddy-avatar-placeholder {
  background: #f3f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.buddy-avatar-text {
  font-size: 32rpx;
}

.buddy-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1c1d;
}

.buddy-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4d4732;
  display: block;
  margin-bottom: 16rpx;
}

.buddy-info {
  background: #f3f3f5;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.buddy-info-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.buddy-info-icon {
  width: 32rpx;
  height: 32rpx;
}

.buddy-info-text {
  font-size: 28rpx;
  color: #4d4732;
}

.buddy-desc {
  font-size: 28rpx;
  color: #4d4732;
  line-height: 1.6;
  display: block;
  margin-bottom: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.buddy-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(208, 198, 171, 0.1);
}

.buddy-btn {
  padding: 16rpx 40rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.detail-btn {
  border: 2rpx solid rgba(208, 198, 171, 0.3);
  color: #5f5e5e;
}

.join-btn {
  background: #ffd700;
  color: #705e00;
  font-weight: 700;
}

.join-btn.joined {
  background: #e0e0e0;
  color: #999;
}

/* 发布活动悬浮按钮 */
.publish-fab {
  position: fixed;
  bottom: 128rpx;
  right: 48rpx;
  z-index: 200;
  width: 112rpx;
  height: 112rpx;
  background: #ffd700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 215, 0, 0.5);
  transition: all 0.2s;
}

.publish-fab:active {
  transform: scale(0.92);
}

.publish-fab-icon {
  font-size: 64rpx;
  color: #705e00;
  font-weight: 300;
  line-height: 1;
}
