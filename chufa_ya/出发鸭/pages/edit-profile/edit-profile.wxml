<!-- 编辑资料页 -->
<view class="page">
  <!-- 顶部导航 -->
  <view class="header" style="padding-top: {{statusBarHeight + 12}}px;">
    <view class="header-left" bindtap="goBack">
      <text class="header-back">←</text>
      <text class="header-title">编辑资料</text>
    </view>
    <view class="header-right" bindtap="saveProfile">
      <text class="header-save">保存</text>
    </view>
  </view>

  <scroll-view scroll-y class="page-content" enhanced show-scrollbar="{{false}}">
    <!-- 头像修改 -->
    <view class="avatar-section">
      <view class="avatar-wrap">
        <image class="avatar-img" src="{{avatar || '/static/Placeholder Icon/默认头像.png'}}" mode="aspectFill"></image>
        <view class="avatar-camera" bindtap="changeAvatar">
          <image class="camera-icon" src="/static/app_tabbar/拍照.png" mode="aspectFit"></image>
        </view>
      </view>
      <text class="avatar-label">修改头像</text>
    </view>

    <!-- 表单 -->
    <view class="form-section">
      <!-- 昵称 -->
      <view class="form-group">
        <text class="form-label">昵称</text>
        <view class="form-input-wrap">
          <input class="form-input" value="{{nickname}}" bindinput="onNicknameInput" />
          <image class="form-input-icon" src="/static/app_tabbar/编辑.png" mode="aspectFit"></image>
        </view>
      </view>

      <!-- 个性签名 -->
      <view class="form-group">
        <text class="form-label">个性签名</text>
        <view class="form-textarea-wrap">
          <textarea class="form-textarea" value="{{bio}}" bindinput="onBioInput" maxlength="50" placeholder="探索不一样的风景，遇见有趣的灵魂。" />
        </view>
        <view class="form-counter">
          <text>{{bioLength}}/50</text>
        </view>
      </view>

      <!-- 账号安全 -->
      <view class="security-section">
        <text class="security-title">账号安全</text>
        <view class="security-list">
          <view class="security-item" bindtap="showPasswordModal">
            <image class="security-icon" src="/static/app_tabbar/修改密码.png" mode="aspectFit"></image>
            <text class="security-text">修改密码</text>
            <text class="security-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <view style="height: 80rpx;"></view>
  </scroll-view>

  <!-- 修改密码弹窗 -->
  <view class="modal-overlay" wx:if="{{showPasswordModal}}" bindtap="hidePasswordModal">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">修改密码</text>
        <text class="modal-close" bindtap="hidePasswordModal">✕</text>
      </view>
      <view class="modal-body">
        <view class="modal-input-group">
          <text class="modal-label">原密码</text>
          <input class="modal-input" placeholder="请输入原密码" password value="{{oldPassword}}" bindinput="onOldPasswordInput" />
        </view>
        <view class="modal-input-group">
          <text class="modal-label">新密码</text>
          <input class="modal-input" placeholder="请输入新密码" password value="{{newPassword}}" bindinput="onNewPasswordInput" />
        </view>
        <view class="modal-input-group">
          <text class="modal-label">确认新密码</text>
          <input class="modal-input" placeholder="请再次输入新密码" password value="{{confirmNewPassword}}" bindinput="onConfirmPasswordInput" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="hidePasswordModal">取消</view>
        <view class="modal-btn confirm" bindtap="confirmPassword">确认修改</view>
      </view>
    </view>
  </view>
</view>
