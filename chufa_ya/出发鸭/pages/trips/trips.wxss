.page {
  min-height: 100vh;
  background: #f9f9fb;
}

.header {
  padding: 12rpx 32rpx 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1c1d;
}

/* Tab 切换 */
.tab-switch {
  display: flex;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
  gap: 40rpx;
}

.tab-item {
  padding-bottom: 12rpx;
  font-size: 32rpx;
  color: #5f5e5e;
  font-weight: 500;
  position: relative;
}

.tab-item.active {
  color: #1a1c1d;
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: #ffd700;
  border-radius: 3rpx;
}

/* 页面内容 */
.page-content {
  padding: 0 32rpx;
}

/* 行程卡片 */
.trip-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.trip-img-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
}

.trip-img {
  width: 100%;
  height: 100%;
}

.trip-img-placeholder {
  background: #f3f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trip-img-text {
  font-size: 64rpx;
}

.trip-img-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
}

.trip-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: #ffd700;
  color: #705d00;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.trip-img-content {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  right: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.trip-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.trip-date {
  color: rgba(255,255,255,0.85);
  font-size: 24rpx;
}

/* 状态标签 */
.trip-status {
  padding: 16rpx 16rpx 0;
}

.trip-status-text {
  display: inline-block;
  font-size: 22rpx;
  color: #5f5e5e;
  background: rgba(255, 215, 0, 0.15);
  backdrop-filter: blur(12rpx);
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
}

.trip-status-done .trip-status-text {
  background: rgba(0, 0, 0, 0.06);
  color: #5f5e5e;
}

/* 操作按钮 */
.trip-actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
}

.trip-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.trip-btn-outline {
  border: 2rpx solid #d0c6ab;
  color: #4d4732;
}

.trip-btn-fill {
  background: #705d00;
  color: #fff;
}

.trip-btn-done {
  background: #ffd700;
  color: #705d00;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 400rpx;
  height: 400rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #5f5e5e;
}

/* FAB */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 96rpx;
  height: 96rpx;
  background: #ffd700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(112, 93, 0, 0.25);
  z-index: 50;
}

.fab-icon {
  font-size: 48rpx;
  color: #705d00;
  font-weight: 300;
}
