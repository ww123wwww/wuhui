<!-- 设置密码页 -->
<view class="login-container">
  <image class="login-bg" src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&q=80" mode="aspectFill"></image>

  <view class="login-header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <view class="help-btn">
      <text>帮助</text>
    </view>
  </view>

  <view class="login-content">
    <view class="login-title">
      <text>设置密码</text>
    </view>
    <view class="login-subtitle">
      <text>请设置您的登录密码</text>
    </view>

    <view class="form-group">
      <input
        type="password"
        value="{{password}}"
        placeholder="请输入密码"
        placeholder-style="color: rgba(255, 255, 255, 0.6)"
        class="input-field"
        bindinput="onPasswordInput"
        bindconfirm="onPasswordConfirm"
      />
    </view>

    <view class="form-group">
      <input
        type="password"
        value="{{confirmPassword}}"
        placeholder="请再次输入密码"
        placeholder-style="color: rgba(255, 255, 255, 0.6)"
        class="input-field"
        bindinput="onConfirmPasswordInput"
        bindconfirm="setPassword"
      />
    </view>

    <view class="login-btn" bindtap="setPassword">
      <text>确认设置</text>
    </view>

    <view class="password-tips">
      <text class="tips-text">密码长度6-20位，建议包含字母和数字</text>
    </view>
  </view>
</view>
