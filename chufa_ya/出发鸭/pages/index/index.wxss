.page {
  min-height: 100vh;
  background: #f9f9fb;
}

/* 顶部搜索 */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(249, 249, 251, 0.95);
  backdrop-filter: blur(20rpx);
  padding: 12rpx 32rpx 16rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #f3f3f5;
  border-radius: 9999rpx;
  padding: 12rpx 16rpx;
  border: 2rpx solid #ffd700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  flex: 1;
  font-size: 28rpx;
  color: #5f5e5e80;
}

.search-btn {
  background: #ffd700;
  color: #705e00;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 28rpx;
  border-radius: 9999rpx;
  white-space: nowrap;
}

.page-content {
  height: calc(100vh - 100rpx);
}

/* Banner */
.banner-section {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.banner-swiper {
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-slide {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-img {
  width: 100%;
}

.banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
}

.banner-text {
  position: absolute;
  bottom: 32rpx;
  left: 32rpx;
}

.banner-title {
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  display: block;
}

.banner-subtitle {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  display: block;
  margin-top: 4rpx;
}

/* 金刚区 */
.kingkong-section {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.kingkong-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.kingkong-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.kingkong-item:active {
  transform: scale(0.95);
}

.kingkong-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.kingkong-icon-text {
  font-size: 48rpx;
}

.kingkong-icon-img {
  width: 160rpx;
  height: 160rpx;
  margin-top: -30rpx;
}

