<!-- 发布动态页 -->
<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight + 12}}px;">
    <view class="header-left" bindtap="goBack">
      <text class="header-close">✕</text>
    </view>
    <text class="header-title">发布动态</text>
    <view class="header-right" bindtap="publish">
      <text class="header-publish {{loading || uploading ? 'disabled' : ''}}">发布</text>
    </view>
  </view>

  <scroll-view scroll-y class="page-content" enhanced show-scrollbar="{{false}}">
    <!-- 图片预览区域 -->
    <view class="image-preview-area" wx:if="{{uploadedImages.length > 0}}">
      <view class="image-preview-list">
        <view class="image-preview-item" wx:for="{{uploadedImages}}" wx:key="index">
          <image wx:if="{{item}}" class="image-preview-img" src="{{item}}" mode="aspectFill"></image>
          <view wx:else class="image-preview-img image-preview-placeholder">
            <text class="image-preview-text">📷</text>
          </view>
          <view class="image-cover-btn {{coverUrl === item ? 'is-cover' : ''}}" data-index="{{index}}" bindtap="setCover">
            <text>{{coverUrl === item ? '封面' : '设为封面'}}</text>
          </view>
          <view class="image-remove-btn" data-index="{{index}}" bindtap="removeImage">
            <text>✕</text>
          </view>
        </view>
        <view class="image-preview-item add-more" bindtap="chooseImage" wx:if="{{uploadedImages.length < 9}}">
          <text class="add-more-icon">+</text>
          <text class="add-more-text">添加图片</text>
        </view>
      </view>
    </view>

    <!-- 图片上传区域 -->
    <view class="upload-area" bindtap="chooseImage" wx:if="{{uploadedImages.length === 0}}">
      <view class="upload-placeholder">
          <image class="upload-icon-img" src="/static/app_tabbar/publish.png" mode="aspectFit"></image>
        <text class="upload-text">点击上传图片/视频</text>
      </view>
    </view>

    <!-- 标题和内容输入 -->
    <view class="input-section">
      <view class="input-title-wrap">
        <input class="input-title" placeholder="填写标题，更有吸引力..." placeholder-style="color:#4d473280;" value="{{title}}" bindinput="onTitleInput" />
      </view>
      <view class="input-content-wrap">
        <textarea class="input-content" placeholder="分享你的旅行趣事吧..." placeholder-style="color:#4d473260;" auto-height value="{{content}}" bindinput="onContentInput" />
      </view>
    </view>

    <!-- 添加地点 -->
    <view class="option-list">
      <view class="option-item" bindtap="selectLocation">
        <image class="option-icon" src="/static/app_tabbar/定位.png" mode="aspectFit"></image>
        <text class="option-text">{{location || '添加地点'}}</text>
        <text class="option-arrow">›</text>
      </view>
    </view>

    <!-- 发布类型选择 -->
    <view class="type-section">
      <text class="type-label">选择发布类型</text>
      <view class="type-grid">
        <view class="type-card {{selectedType === 'note' ? 'selected' : ''}}" data-type="note" bindtap="selectType">
          <view class="type-card-icon type-icon-tertiary">
            <text>📖</text>
          </view>
          <text class="type-card-text">写游记</text>
        </view>
        <view class="type-card {{selectedType === 'travelogue' ? 'selected' : ''}}" data-type="travelogue" bindtap="selectType">
          <view class="type-card-icon type-icon-primary">
            <image src="/static/app_tabbar/定位.png" mode="aspectFit" style="width:36rpx;height:36rpx;"></image>
          </view>
          <text class="type-card-text">发攻略</text>
        </view>
        <view class="type-card {{selectedType === 'guide' ? 'selected' : ''}}" data-type="guide" bindtap="selectType">
          <view class="type-card-icon type-icon-secondary">
            <text>🚗</text>
          </view>
          <text class="type-card-text">自驾游</text>
        </view>
      </view>
    </view>

    <view style="height: 200rpx;"></view>
  </scroll-view>

  <!-- 上传中提示 -->
  <view class="uploading-mask" wx:if="{{uploading}}">
    <view class="uploading-box">
      <text class="uploading-text">图片上传中...</text>
    </view>
  </view>

  <tab-bar current="2" hide-selected="{{true}}"></tab-bar>
</view>