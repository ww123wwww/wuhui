<!-- 发布活动页 -->
<view class="page">
  <!-- 顶部导航 -->
  <view class="header" style="padding-top: {{statusBarHeight + 8}}px;">
    <view class="header-back" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
  </view>

  <scroll-view scroll-y class="page-content" enhanced show-scrollbar="{{false}}">
    <!-- 封面图上传 -->
    <view class="section">
      <view class="cover-upload" bindtap="chooseCover">
        <image wx:if="{{coverImage}}" class="cover-preview" src="{{coverImage}}" mode="aspectFill"></image>
        <view class="cover-placeholder" wx:if="{{!coverImage}}">
          <text class="cover-icon">📷</text>
          <text class="cover-text">添加封面图</text>
        </view>
      </view>
    </view>

    <!-- 活动标题 -->
    <view class="section card">
      <text class="card-label">活动标题</text>
      <input class="card-input" placeholder="例如：西藏春日桃花之旅" placeholder-style="color:#d0c6ab;" value="{{title}}" bindinput="onTitleInput" />
    </view>

    <!-- 表单详情 -->
    <view class="section card">
      <!-- 目的地 -->
      <view class="form-row" bindtap="chooseDestination">
        <view class="form-row-left">
          <image class="form-icon" src="/static/app_tabbar/定位.png" mode="aspectFit"></image>
          <text class="form-label">目的地</text>
        </view>
        <view class="form-row-right">
          <text class="form-value">{{destination || '请选择'}}</text>
          <text class="form-arrow">›</text>
        </view>
      </view>
      <view class="form-divider"></view>

      <!-- 行程日期 -->
      <view class="form-row" bindtap="chooseDate">
        <view class="form-row-left">
          <text class="form-icon">📅</text>
          <text class="form-label">行程日期</text>
        </view>
        <view class="form-row-right">
          <text class="form-value">{{dateRange || '选择出发与结束'}}</text>
          <text class="form-arrow">›</text>
        </view>
      </view>
      <view class="form-divider"></view>

      <!-- 期待人数 -->
      <view class="form-row">
        <view class="form-row-left">
          <text class="form-icon">👥</text>
          <text class="form-label">期待人数</text>
        </view>
        <view class="people-counter">
          <view class="counter-btn {{peopleCount <= 1 ? 'disabled' : ''}}" bindtap="decreasePeople">
            <text>−</text>
          </view>
          <text class="counter-value">{{peopleCount}}</text>
          <view class="counter-btn" bindtap="increasePeople">
            <text>+</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 详情描述 -->
    <view class="section card">
      <text class="card-label">详情描述</text>
      <textarea class="card-textarea" placeholder="计划在桃花盛开的季节去西藏，寻找志同道合的伙伴一起租车出发。希望能你会拍照或者开车..." placeholder-style="color:#d0c6ab;" value="{{description}}" bindinput="onDescInput" auto-height maxlength="500" />
    </view>

    <view style="height: 240rpx;"></view>
  </scroll-view>

  <!-- 底部发布按钮 -->
  <view class="bottom-bar">
    <view class="publish-btn {{isSubmitting ? 'submitting' : ''}}" bindtap="submitPublish">
      <text wx:if="{{!isSubmitting}}">立即发布</text>
      <text wx:else>发布中...</text>
    </view>
  </view>
</view>
