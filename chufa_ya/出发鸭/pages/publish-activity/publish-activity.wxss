.page {
  min-height: 100vh;
  background: #f9f9fb;
}

/* 顶部导航 */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #f9f9fb;
  padding: 0 32rpx 12rpx;
}

.header-back {
  display: inline-flex;
  padding: 4rpx;
}

.header-back:active {
  transform: scale(0.95);
}

.back-icon {
  font-size: 44rpx;
  color: #705d00;
  font-weight: 700;
}

/* 内容区域 */
.page-content {
  height: calc(100vh - 100rpx);
  padding: 0 32rpx;
}

/* 统一板块间距 */
.section {
  margin-bottom: 32rpx;
}

/* 卡片容器 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #eeeef0;
}

/* 封面图上传 */
.cover-upload {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #f3f3f5;
  border-radius: 24rpx;
  border: 4rpx dashed #d0c6ab;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
  transition: all 0.3s;
}

.cover-upload:active {
  border-color: #ffd700;
}

.cover-preview {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.cover-icon {
  font-size: 64rpx;
}

.cover-text {
  font-size: 24rpx;
  color: #4d4732;
  font-weight: 500;
}

/* 表单标签和输入 */
.card-label {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1c1d;
  margin-bottom: 20rpx;
}

.card-input {
  width: 100%;
  font-size: 32rpx;
  background: transparent;
  padding: 0;
}

.card-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 28rpx;
  color: #1a1c1d;
  background: transparent;
  padding: 0;
  line-height: 1.6;
}

/* 表单行 */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.form-row:active {
  opacity: 0.7;
}

.form-row-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.form-icon {
  width: 36rpx;
  height: 36rpx;
}

.form-label {
  font-size: 32rpx;
  color: #1a1c1d;
}

.form-row-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.form-value {
  font-size: 28rpx;
  color: #4d4732;
}

.form-arrow {
  font-size: 36rpx;
  color: #7e775f;
}

.form-divider {
  height: 2rpx;
  background: #eeeef0;
  margin: 24rpx 0;
}

/* 人数计数器 */
.people-counter {
  display: flex;
  align-items: center;
  background: #eeeef0;
  border-radius: 9999rpx;
  padding: 4rpx 8rpx;
}

.counter-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 36rpx;
  color: #1a1c1d;
  font-weight: 500;
}

.counter-btn:active {
  background: #e8e8ea;
  transform: scale(0.9);
}

.counter-btn.disabled {
  opacity: 0.3;
}

.counter-value {
  padding: 0 32rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1c1d;
}

/* 底部发布按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 80;
  padding: 32rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f9f9fb, #f9f9fb 60%, transparent);
}

.publish-btn {
  width: 100%;
  height: 112rpx;
  background: #ffd700;
  color: #705e00;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(255, 215, 0, 0.3);
  transition: all 0.2s;
}

.publish-btn:active {
  transform: scale(0.98);
}

.publish-btn.submitting {
  opacity: 0.7;
}
