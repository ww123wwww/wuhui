.login-container {
  width: 100%;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* 背景图层 */
.login-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 渐变遮罩覆盖在背景上 */
.login-container::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(212, 165, 116, 0.35) 0%, rgba(196, 149, 106, 0.45) 50%, rgba(139, 115, 85, 0.55) 100%);
  z-index: 0;
}

.login-content {
  flex: 1;
  padding: 0 60rpx;
  position: relative;
  z-index: 1;
}

.login-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 100rpx 60rpx 160rpx;
  position: relative;
  z-index: 1;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  color: #fff;
  font-size: 48rpx;
}

.help-btn {
  color: #fff;
  font-size: 32rpx;
}

.login-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 24rpx;
}

.login-subtitle {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 120rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.input-field {
  width: 100%;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50rpx;
  border: none;
  padding: 0 40rpx;
  font-size: 32rpx;
  color: #fff;
  box-sizing: border-box;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  font-size: 36rpx;
  color: #fff;
  margin-top: 80rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn:active {
  background: rgba(255, 255, 255, 0.4);
  transform: scale(0.98);
}

.login-options {
  display: flex;
  justify-content: space-between;
  margin-bottom: 160rpx;
}

.option-item {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

.third-party-login {
  margin-bottom: 80rpx;
}

.third-party-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 40rpx;
  text-align: center;
}

.third-party-icons {
  display: flex;
  justify-content: center;
  gap: 80rpx;
}

.icon-item {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.icon-image {
  width: 60rpx;
  height: 60rpx;
}

.agreement {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.4;
}

.agreement-label {
  display: flex;
  align-items: center;
}

.agreement-text {
  margin-left: 16rpx;
  flex: 1;
}

.agreement-link {
  text-decoration: underline;
  color: rgba(255, 255, 255, 0.8);
}
