.page {
  min-height: 100vh;
  background: #f9f9fb;
}

/* 顶部透明导航 */
.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  padding: 12rpx 32rpx;
}

.nav-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
}

/* 大图 */
.hero {
  width: 100%;
  height: 60vh;
  position: relative;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-img-placeholder {
  background: #f3f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-img-text {
  font-size: 80rpx;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, transparent 20%, transparent 80%, rgba(0,0,0,0.5) 100%);
}

/* 内容 */
.content {
  position: relative;
  z-index: 10;
  margin-top: -60rpx;
  min-height: 40vh;
}

.content-card {
  background: #fff;
  border-radius: 64rpx 64rpx 0 0;
  padding: 0 32rpx;
  box-shadow: 0 -20rpx 60rpx rgba(0, 0, 0, 0.05);
}

.pull-handle {
  width: 96rpx;
  height: 6rpx;
  background: #e8e8ea;
  border-radius: 9999rpx;
  margin: 0 auto;
  margin-top: 24rpx;
  margin-bottom: 32rpx;
}

/* 标签 */
.tag-wrap {
  margin-bottom: 24rpx;
}

.tag {
  display: inline-block;
  background: #ffd700;
  color: #705e00;
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
}

.guide-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1c1d;
  line-height: 1.3;
  display: block;
  margin-bottom: 24rpx;
}

/* 作者卡片 */
.author-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f3f3f5;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid rgba(208, 198, 171, 0.3);
}

.author-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #705d00;
}

.author-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1c1d;
  display: block;
}

.author-desc {
  font-size: 24rpx;
  color: #5f5e5e;
  display: block;
}

.follow-btn {
  background: #ffd700;
  color: #705e00;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 40rpx;
  border-radius: 9999rpx;
}

.follow-btn.followed {
  background: #eeeef0;
  color: #5f5e5e;
}

/* 区块 */
.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.section-icon {
  width: 40rpx;
  height: 40rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1c1d;
}

.overview-text {
  padding: 32rpx;
  background: #f9f9fb;
  border-radius: 32rpx;
  border-left: 8rpx solid #705d00;
  font-size: 32rpx;
  color: #5f5e5e;
  line-height: 1.7;
}

/* 站点网格 */
.stops-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stop-card {
  position: relative;
  height: 280rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.stop-large {
  grid-column: span 2;
  height: 360rpx;
}

.stop-img {
  width: 100%;
  height: 100%;
}

.stop-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
}

.stop-label {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

/* 统计 */
.stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 36rpx;
  background: #e8e8ea;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #705d00;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #5f5e5e;
  display: block;
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 64rpx;
  background: #d0c6ab;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.1);
  z-index: 99;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.bottom-actions {
  display: flex;
  gap: 40rpx;
}

.bottom-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.bottom-action-icon {
  width: 44rpx;
  height: 44rpx;
}

.bottom-action-label {
  font-size: 20rpx;
  color: #5f5e5e;
}

.save-btn {
  background: #705d00;
  color: #fff;
  padding: 20rpx 48rpx;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(112, 93, 0, 0.2);
}

.save-btn.saved {
  background: #fff;
  color: #705d00;
  border: 2rpx solid #705d00;
  box-shadow: none;
}

/* 弹窗遮罩 */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 弹窗主体 */
.author-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 40rpx;
  position: relative;
  overflow: hidden;
}

/* 关闭按钮 */
.modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 32rpx;
  z-index: 10;
}

/* 弹窗内容 */
.author-modal-content {
  padding: 60rpx 40rpx;
  text-align: center;
}

/* 头像 */
.modal-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 24rpx;
  border: 4rpx solid #f0f0f0;
}

/* 昵称 */
.modal-nickname {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

/* 标签 */
.modal-tag {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 32rpx;
}

/* 统计信息 */
.modal-stats {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  margin-bottom: 40rpx;
}

.modal-stat {
  text-align: center;
}

.modal-stat .stat-num {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-stat .stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 操作按钮 */
.modal-actions {
  display: flex;
  gap: 32rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.modal-btn.follow-btn {
  background: #ffd700;
  color: #221b00;
  font-weight: 700;
}

.modal-btn.follow-btn.following {
  background: #e0e0e0;
  color: #999;
}

.modal-btn.message-btn {
  background: #f0f0f0;
  color: #333;
}
