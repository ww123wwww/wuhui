.page {
  min-height: 100vh;
  background: #f9f9fb;
}

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(249, 249, 251, 0.95);
  backdrop-filter: blur(20rpx);
  padding: 0 32rpx 16rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-bottom: 8rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: -8rpx;
  border-radius: 50%;
  transition: background 0.2s;
}

.back-btn:active {
  background: #eeeef0;
}

.back-icon {
  font-size: 40rpx;
  color: #1a1c1d;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #f3f3f5;
  border-radius: 9999rpx;
  padding: 8rpx 8rpx 8rpx 16rpx;
}

.search-location {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding-right: 16rpx;
  margin-right: 12rpx;
  border-right: 2rpx solid #d0c6ab;
  flex-shrink: 0;
}

.search-loc-icon {
  width: 32rpx;
  height: 32rpx;
}

.search-loc-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1c1d;
}

.search-loc-arrow {
  font-size: 24rpx;
  color: #5f5e5e;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  background: transparent;
  color: #1a1c1d;
}

.search-btn {
  background: #ffd700;
  color: #705e00;
  font-size: 24rpx;
  font-weight: 700;
  padding: 16rpx 36rpx;
  border-radius: 9999rpx;
  white-space: nowrap;
}

.page-content {
  padding: 0 32rpx;
}

.section-header {
  margin: 24rpx 0;
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1c1d;
}

/* 瀑布流布局 */
.guide-waterfall {
  display: flex;
  gap: 24rpx;
}

.waterfall-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.guide-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.guide-img-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.guide-img-wrap.ratio-34 {
  aspect-ratio: 3/4;
}

.guide-img-wrap.ratio-square {
  aspect-ratio: 1/1;
}

.guide-img {
  width: 100%;
  height: 100%;
}

.guide-img-placeholder {
  background: #f3f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-img-text {
  font-size: 64rpx;
}

.guide-rating {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(12rpx);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.guide-star {
  font-size: 24rpx;
}

.guide-score {
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

.guide-body {
  padding: 20rpx;
}

.guide-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1c1d;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.guide-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.guide-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.guide-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.guide-avatar-placeholder {
  background: #f3f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-avatar-text {
  font-size: 20rpx;
}

.guide-author-name {
  font-size: 22rpx;
  color: #5f5e5e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guide-likes {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.guide-like-icon {
  width: 32rpx;
  height: 32rpx;
}

.guide-like-count {
  font-size: 22rpx;
  color: #5f5e5e;
}
