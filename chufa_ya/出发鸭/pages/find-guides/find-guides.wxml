<!-- 找攻略 - 子页面 -->
<view class="page">
  <!-- 顶部导航栏 + 搜索 -->
  <view class="header" style="padding-top: {{statusBarHeight + 12}}px;">
    <view class="nav-bar">
      <view class="back-btn" bindtap="goBack">
        <text class="back-icon">←</text>
      </view>
    </view>
    <view class="search-bar">
      <view class="search-location" bindtap="selectCity">
        <image class="search-loc-icon" src="/static/app_tabbar/定位.png" mode="aspectFit"></image>
        <text class="search-loc-text">{{currentCity}}</text>
        <text class="search-loc-arrow">▾</text>
      </view>
      <image class="search-icon" src="/static/app_tabbar/搜索.png" mode="aspectFit"></image>
      <input class="search-input" placeholder="想去哪里攻略？" placeholder-style="color:#5f5e5e80;" />
      <view class="search-btn">
        <text>搜索</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="page-content" enhanced show-scrollbar="{{false}}">
    <!-- 热门攻略标题 -->
    <view class="section-header">
      <text class="section-title">热门攻略</text>
    </view>

    <!-- 攻略瀑布流 -->
    <view class="guide-waterfall">
      <view class="waterfall-col">
        <block wx:for="{{guides}}" wx:key="id" wx:if="{{index % 2 === 0}}">
          <view class="guide-card" bindtap="viewGuide" data-id="{{item.id}}">
            <view class="guide-img-wrap {{item.imgRatio === 'square' ? 'ratio-square' : 'ratio-34'}}">
              <image wx:if="{{item.image}}" class="guide-img" src="{{item.image}}" mode="aspectFill"></image>
              <view wx:else class="guide-img guide-img-placeholder">
                <text class="guide-img-text">📷</text>
              </view>
              <view class="guide-rating" wx:if="{{item.rating}}">
                <text class="guide-star">⭐</text>
                <text class="guide-score">{{item.rating}}</text>
              </view>
            </view>
            <view class="guide-body">
              <text class="guide-title">{{item.title}}</text>
              <view class="guide-footer">
                <view class="guide-author">
                  <image class="guide-avatar" src="{{item.avatar || '/static/Placeholder Icon/默认头像.png'}}" mode="aspectFill"></image>
                  <text class="guide-author-name">{{item.author}}</text>
                </view>
                <view class="guide-likes">
                  <image class="guide-like-icon" src="{{item.isLiked ? '/static/app_tabbar/已点赞.png' : '/static/app_tabbar/点赞.png'}}" mode="aspectFit"></image>
                  <text class="guide-like-count">{{item.likes}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
      <view class="waterfall-col">
        <block wx:for="{{guides}}" wx:key="id" wx:if="{{index % 2 === 1}}">
          <view class="guide-card" bindtap="viewGuide" data-id="{{item.id}}">
            <view class="guide-img-wrap {{item.imgRatio === 'square' ? 'ratio-square' : 'ratio-34'}}">
              <image wx:if="{{item.image}}" class="guide-img" src="{{item.image}}" mode="aspectFill"></image>
              <view wx:else class="guide-img guide-img-placeholder">
                <text class="guide-img-text">📷</text>
              </view>
              <view class="guide-rating" wx:if="{{item.rating}}">
                <text class="guide-star">⭐</text>
                <text class="guide-score">{{item.rating}}</text>
              </view>
            </view>
            <view class="guide-body">
              <text class="guide-title">{{item.title}}</text>
              <view class="guide-footer">
                <view class="guide-author">
                  <image class="guide-avatar" src="{{item.avatar || '/static/Placeholder Icon/默认头像.png'}}" mode="aspectFill"></image>
                  <text class="guide-author-name">{{item.author}}</text>
                </view>
                <view class="guide-likes">
                  <image class="guide-like-icon" src="{{item.isLiked ? '/static/app_tabbar/已点赞.png' : '/static/app_tabbar/点赞.png'}}" mode="aspectFit"></image>
                  <text class="guide-like-count">{{item.likes}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view style="height: 40rpx;"></view>
  </scroll-view>
</view>
