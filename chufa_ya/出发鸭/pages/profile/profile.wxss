.page {
  min-height: 100vh;
  background: #f9f9fb;
}

.page-content {
  padding: 0 32rpx;
}

/* 用户信息 */
.profile-header {
  padding-bottom: 32rpx;
}

.profile-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar-wrap {
  position: relative;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 8rpx solid #ffd700;
}

.profile-avatar-placeholder {
  background: #f3f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-text {
  font-size: 64rpx;
}

.profile-detail {
  flex: 1;
}

.profile-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1c1d;
  display: block;
}

.profile-bio {
  font-size: 28rpx;
  color: #4d4732;
  margin-top: 8rpx;
  display: block;
}

/* 统计数据 */
.profile-stats {
  display: flex;
  gap: 48rpx;
  margin-top: 24rpx;
}

.profile-stat {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1c1d;
}

.stat-label {
  font-size: 24rpx;
  color: #4d4732;
}

/* 操作按钮 */
.profile-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: #e8e8ea;
  color: #1a1c1d;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn-icon {
  width: 32rpx;
  height: 32rpx;
}

.logout-btn {
  color: #ba1a1a;
}

/* Tab */
.tabs {
  display: flex;
  border-bottom: 2rpx solid #e8e8ea;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #4d4732;
  position: relative;
}

.tab.active {
  color: #705d00;
  font-weight: 700;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #ffd700;
  border-radius: 4rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #5f5e5e;
}

/* 瀑布流 */
.waterfall {
  display: flex;
  gap: 24rpx;
}

.waterfall-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.waterfall-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.waterfall-card:active {
  transform: scale(0.98);
}

.waterfall-img-wrap {
  width: 100%;
  position: relative;
}

/* 更多按钮 (...) */
.more-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 52rpx;
  height: 52rpx;
  background: transparent;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.more-icon {
  color: #000000;
  font-size: 50rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

/* 下拉菜单 */
.more-dropdown {
  position: absolute;
  top: 60rpx;
  right: 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  white-space: nowrap;
  z-index: 20;
}

.more-dropdown::before {
  content: '';
  position: absolute;
  top: -12rpx;
  right: 20rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 12rpx solid #fff;
}

.dropdown-icon {
  font-size: 28rpx;
}

.dropdown-text {
  font-size: 26rpx;
  color: #ba1a1a;
  font-weight: 500;
}

.waterfall-img {
  width: 100%;
  display: block;
}

.waterfall-body {
  padding: 20rpx;
}

.waterfall-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1c1d;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.waterfall-footer {
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.waterfall-likes {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.waterfall-like-icon {
  width: 32rpx;
  height: 32rpx;
}

.waterfall-like-icon.liked {
  color: #ba1a1a;
}

.waterfall-like-count {
  font-size: 20rpx;
  color: #5f5e5e;
}

/* 活动列表 */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.activity-card:active {
  transform: scale(0.98);
}

.activity-cover {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
}

.activity-cover-placeholder {
  background: #f3f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.activity-cover-text {
  font-size: 48rpx;
}

.activity-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.activity-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1c1d;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
}

.activity-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 16rpx;
}

.activity-meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 24rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #5f5e5e;
}

.activity-status {
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  background: #fff3cd;
  color: #856404;
  font-size: 24rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}

.activity-status.full {
  background: #f8d7da;
  color: #721c24;
}
