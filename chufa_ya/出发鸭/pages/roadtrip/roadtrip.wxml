<!-- 自驾游页 - _8 -->
<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight + 12}}px;">
    <view class="header-left" bindtap="goBack">
      <text class="header-back">←</text>
    </view>
    <view class="header-center">
      <text class="header-title">自驾游</text>
    </view>
    <view class="header-right"></view>
  </view>

  <scroll-view scroll-y class="page-content" enhanced show-scrollbar="{{false}}">
    <!-- 搜索 -->
    <view class="search-section">
      <view class="search-bar">
        <image class="search-icon" src="/static/app_tabbar/搜索.png" mode="aspectFit"></image>
        <input class="search-input" placeholder="搜索目的地、路线..." placeholder-style="color:#4d473280;" />
        <view class="search-btn">
          <text>搜索</text>
        </view>
      </view>
    </view>

    <!-- 推荐路线 -->
    <view class="section-header">
      <text class="section-title">推荐路线</text>
    </view>

    <view class="route-list">
      <view class="route-card" wx:for="{{routes}}" wx:key="id" bindtap="viewRoute" data-id="{{item.id}}">
        <view class="route-img-wrap">
          <image wx:if="{{item.image}}" class="route-img" src="{{item.image}}" mode="aspectFill"></image>
          <view wx:else class="route-img route-img-placeholder">
            <text class="route-img-text">📷</text>
          </view>
          <view class="route-badge" wx:if="{{item.badge}}">
            <text>{{item.badge}}</text>
          </view>
          <view class="route-overlay"></view>
          <view class="route-location">
            <image class="route-loc-icon" src="/static/app_tabbar/定位.png" mode="aspectFit"></image>
            <text class="route-loc-text">{{item.location}}</text>
          </view>
        </view>
        <view class="route-body">
          <text class="route-title">{{item.title}}</text>
        </view>
      </view>
    </view>

    <view style="height: 80rpx;"></view>
  </scroll-view>
</view>
