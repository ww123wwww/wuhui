/* 全局样式 - 出发鸭设计系统 */
page {
  --primary: #FFD700;
  --primary-dark: #705d00;
  --primary-container: #ffd700;
  --on-primary-container: #705e00;
  --on-primary: #ffffff;
  --background: #f9f9fb;
  --surface: #f9f9fb;
  --surface-container-lowest: #ffffff;
  --surface-container-low: #f3f3f5;
  --surface-container: #eeeef0;
  --surface-container-high: #e8e8ea;
  --surface-container-highest: #e2e2e4;
  --on-surface: #1a1c1d;
  --on-surface-variant: #4d4732;
  --secondary: #5f5e5e;
  --on-secondary: #ffffff;
  --outline: #7e775f;
  --outline-variant: #d0c6ab;
  --error: #ba1a1a;
  --on-error: #ffffff;
  --tertiary: #b02f00;
  --tertiary-container: #ffcfc2;

  --font-headline-xl: 24px;
  --font-headline-lg: 20px;
  --font-headline-md: 18px;
  --font-body-lg: 16px;
  --font-body-md: 14px;
  --font-label-sm: 12px;

  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-full: 9999rpx;

  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --margin-page: 32rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background-color: var(--background);
  color: var(--on-surface);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 重置 */
view, text, image, scroll-view, swiper, swiper-item, button, input, textarea {
  box-sizing: border-box;
}

/* 隐藏滚动条 */
.hide-scrollbar::-webkit-scrollbar {
  display: none;
}

/* 通用间距 */
.mt-sm { margin-top: 16rpx; }
.mt-md { margin-top: 24rpx; }
.mt-lg { margin-top: 32rpx; }
.mb-sm { margin-bottom: 16rpx; }
.mb-md { margin-bottom: 24rpx; }
.mb-lg { margin-bottom: 32rpx; }
.px-page { padding-left: 32rpx; padding-right: 32rpx; }

/* 安全区域 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 文本 */
.text-primary { color: var(--primary-dark); }
.text-secondary { color: var(--secondary); }
.text-on-surface { color: var(--on-surface); }
.text-on-surface-variant { color: var(--on-surface-variant); }
.text-error { color: var(--error); }
.text-xs { font-size: 20rpx; }
.text-sm { font-size: 24rpx; }
.text-md { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 40rpx; }
.font-bold { font-weight: 700; }
.font-semibold { font-weight: 600; }
.font-medium { font-weight: 500; }
.text-center { text-align: center; }
.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.line-clamp-2 { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

/* Flex */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }
.gap-sm { gap: 16rpx; }
.gap-md { gap: 24rpx; }

/* 卡片 */
.card {
  background: var(--surface-container-lowest);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.card-shadow {
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 按钮 */
.btn-primary {
  background: var(--primary-container);
  color: var(--on-primary-container);
  border-radius: var(--radius-full);
  font-weight: 600;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
.btn-primary::after { border: none; }

.btn-secondary {
  background: transparent;
  color: var(--secondary);
  border: 2rpx solid var(--outline-variant);
  border-radius: var(--radius-lg);
  font-weight: 500;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-secondary::after { border: none; }

.btn-ghost {
  background: var(--surface-container-high);
  color: var(--on-surface);
  border-radius: var(--radius-lg);
  font-size: 24rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
.btn-ghost::after { border: none; }

/* FAB 发布按钮 */
.fab {
  width: 112rpx;
  height: 112rpx;
  background: var(--primary-container);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}
